{
  "uid": "ledgerflow-operations",
  "title": "LedgerFlow — sandbox operations",
  "tags": ["ledgerflow", "sandbox"],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "API scrape health", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "ledgerflow-prometheus"}, "targets": [{"expr": "up{job=\"ledgerflow-api\"}", "refId": "A"}]},
    {"id": 2, "type": "stat", "title": "Outbox backlog", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "ledgerflow-prometheus"}, "targets": [{"expr": "ledgerflow_outbox_backlog", "refId": "A"}]},
    {"id": 3, "type": "stat", "title": "Financial invariant violations", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "ledgerflow-prometheus"}, "targets": [{"expr": "ledgerflow_invariant_violations_total", "refId": "A"}]},
    {"id": 4, "type": "stat", "title": "Reconciliation discrepancies", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "ledgerflow-prometheus"}, "targets": [{"expr": "ledgerflow_reconciliation_discrepancies", "refId": "A"}]},
    {"id": 5, "type": "timeseries", "title": "HTTP request rate", "gridPos": {"x": 0, "y": 5, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "ledgerflow-prometheus"}, "targets": [{"expr": "sum by (method, status) (rate(ledgerflow_http_requests_total[5m]))", "refId": "A"}]},
    {"id": 6, "type": "timeseries", "title": "HTTP latency p95", "gridPos": {"x": 12, "y": 5, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "ledgerflow-prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(ledgerflow_http_request_duration_seconds_bucket[5m])))", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 7, "type": "timeseries", "title": "Payment outcomes", "gridPos": {"x": 0, "y": 13, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "ledgerflow-prometheus"}, "targets": [{"expr": "sum by (status) (rate(ledgerflow_payments_total[5m]))", "refId": "A"}]},
    {"id": 8, "type": "timeseries", "title": "Webhook failures", "gridPos": {"x": 12, "y": 13, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "ledgerflow-prometheus"}, "targets": [{"expr": "rate(ledgerflow_webhook_failures_total[5m])", "refId": "A"}]}
  ]
}

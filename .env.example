# Synthetic local sandbox values only. No external accounts or real funds.
SANDBOX_MODE=true
POSTGRES_PASSWORD=ledgerflow
RUNTIME_DB_PASSWORD=ledgerflow_app
RABBITMQ_PASSWORD=ledgerflow
JWT_SECRET=sandbox-jwt-signing-key-not-for-production-2026
WEBHOOK_SECRET=sandbox-webhook-signing-secret

# Host-based development. Compose explicitly replaces service URLs with its DNS names.
DATABASE_URL=postgresql+asyncpg://ledgerflow_app:ledgerflow_app@127.0.0.1:55432/ledgerflow
# Host migrations/bootstrap use this owner URL explicitly; runtime never receives it.
MIGRATION_DATABASE_URL=postgresql+asyncpg://ledgerflow:ledgerflow@127.0.0.1:55432/ledgerflow
REDIS_URL=redis://127.0.0.1:56379/0
RABBITMQ_URL=amqp://ledgerflow:ledgerflow@127.0.0.1:5673/
PROVIDER_ALPHA_URL=http://127.0.0.1:9001
PROVIDER_BETA_URL=http://127.0.0.1:9002
WEBHOOK_RECEIVER_URL=http://127.0.0.1:9003/events
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional: docker compose --profile monitoring up --build -d
# Enable backend trace export only while the monitoring profile is running.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
